local function createButton(parent, name, cb)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(32, 24, 48)
    btn.TextColor3 = Color3.fromRGB(235, 235, 235)
    btn.Text = name
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamMedium
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(70, 45, 105)
    stroke.Transparency = 0.5
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.BackgroundColor3 = active and Color3.fromRGB(120, 30, 180) or Color3.fromRGB(32, 24, 48)
        stroke.Color = active and Color3.fromRGB(200, 100, 255) or Color3.fromRGB(70, 45, 105)
        cb(active)
    end)
end

local activeDraggingSlider = nil
local function createSlider(parent, name, min, default, max, cb)
    local realMin, realMax = min or 1, max or 1000
    local currentValue = math.clamp(default, realMin, realMax)
    local stepValue = 1

    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -10, 0, 56)
    frame.BackgroundColor3 = Color3.fromRGB(26, 19, 40)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -110, 0, 22)
    label.Position = UDim2.new(0, 8, 0, 4)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.Text = name .. " (ปัจจุบัน: " .. currentValue .. ")"
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    
    local sliderBg = Instance.new("TextButton", frame)
    sliderBg.Size = UDim2.new(1, -16, 0, 8)
    sliderBg.Position = UDim2.new(0, 8, 0, 34)
    sliderBg.BackgroundColor3 = Color3.fromRGB(45, 32, 70)
    sliderBg.Text = ""
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(0, 4)
    
    local fill = Instance.new("Frame", sliderBg)
    fill.Size = UDim2.new((currentValue - realMin)/(realMax - realMin), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(180, 80, 255)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)
    
    local valBox = Instance.new("TextBox", frame)
    valBox.Size = UDim2.new(0, 42, 0, 20)
    valBox.Position = UDim2.new(1, -64, 0, 5)
    valBox.BackgroundColor3 = Color3.fromRGB(35, 25, 55)
    valBox.TextColor3 = Color3.fromRGB(230, 180, 255)
    valBox.Text = tostring(stepValue)
    valBox.TextSize = 11
    valBox.Font = Enum.Font.GothamBold
    valBox.ClearTextOnFocus = false
    Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 4)

    local function updateValue(newVal)
        currentValue = math.clamp(newVal, realMin, realMax)
        fill.Size = UDim2.new((currentValue - realMin)/(realMax - realMin), 0, 1, 0)
        label.Text = name .. " (ปัจจุบัน: " .. currentValue .. ")"
        cb(currentValue)
    end

    local function getStep()
        local num = tonumber(valBox.Text)
        if num and num > 0 then return math.floor(num + 0.5) end
        return 1
    end

    valBox.FocusLost:Connect(function()
        local step = tonumber(valBox.Text)
        if not step or step <= 0 then valBox.Text = tostring(stepValue)
        else stepValue = math.clamp(math.floor(step + 0.5), 1, realMax); valBox.Text = tostring(stepValue) end
    end)

    valBox:GetPropertyChangedSignal("Text"):Connect(function()
        local text = valBox.Text:gsub("%D", "")
        if #text > 4 then text = text:sub(1, 4) end
        if valBox.Text ~= text then valBox.Text = text end
    end)

    local minusBtn = Instance.new("TextButton", frame)
    minusBtn.Size = UDim2.new(0, 22, 0, 20)
    minusBtn.Position = UDim2.new(1, -88, 0, 5)
    minusBtn.BackgroundColor3 = Color3.fromRGB(45, 32, 70)
    minusBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
    minusBtn.Text = "-"
    minusBtn.TextSize = 12
    minusBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", minusBtn).CornerRadius = UDim.new(0, 4)
    minusBtn.MouseButton1Click:Connect(function() updateValue(currentValue - getStep()) end)

    local plusBtn = Instance.new("TextButton", frame)
    plusBtn.Size = UDim2.new(0, 22, 0, 20)
    plusBtn.Position = UDim2.new(1, -20, 0, 5)
    plusBtn.BackgroundColor3 = Color3.fromRGB(45, 32, 70)
    plusBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
    plusBtn.Text = "+"
    plusBtn.TextSize = 12
    plusBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 4)
    plusBtn.MouseButton1Click:Connect(function() updateValue(currentValue + getStep()) end)

    local draggingSlider = false
    sliderBg.InputBegan:Connect(function(i) 
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and not activeDraggingSlider then
            draggingSlider = true; activeDraggingSlider = sliderBg
        end 
    end)
    UserInputService.InputEnded:Connect(function(i) 
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and draggingSlider then
            draggingSlider = false; if activeDraggingSlider == sliderBg then activeDraggingSlider = nil end
        end 
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingSlider and activeDraggingSlider == sliderBg and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local pos = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            updateValue(math.floor(realMin + (realMax - realMin) * pos + 0.5))
        end
    end)
    updateValue(currentValue)
end

