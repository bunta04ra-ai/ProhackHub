-- 2. ESP มองทะลุ
local espHigh, espTracer, espBox, fullbright = false, false, false, false
createButton(C2, "1. เส้นชี้ (Tracer)", function(st) espTracer = st end)
createButton(C2, "2. ออร่า (Highlight)", function(st) espHigh = st end)
createButton(C2, "3. ESP Box (2D + หลอดเลือดซ้าย)", function(st) espBox = st end)
createButton(C2, "เพิ่มแสงสว่าง (Fullbright)", function(st) fullbright = st end)

local tracers, boxGUIs = {}, {}
RunService.RenderStepped:Connect(function()
    pcall(function()
        local Lighting = game:GetService("Lighting")
        Lighting.Ambient = fullbright and Color3.new(1,1,1) or Color3.new(0.5,0.5,0.5)
        Lighting.OutdoorAmbient = fullbright and Color3.new(1,1,1) or Color3.new(0.5,0.5,0.5)
    end)

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local teamCol = isSameTeam(p) and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)

            if espHigh and char and char:FindFirstChild("HumanoidRootPart") then
                local hl = char:FindFirstChild("ProHighlight") or Instance.new("Highlight", char)
                hl.Name, hl.Adornee, hl.FillTransparency = "ProHighlight", char, 0.5
                hl.FillColor, hl.OutlineColor = teamCol, teamCol
            elseif char and char:FindFirstChild("ProHighlight") then
                char.ProHighlight:Destroy()
            end

            if espTracer and char and char:FindFirstChild("HumanoidRootPart") and Drawing then
                local line = tracers[p] or Drawing.new("Line")
                tracers[p] = line
                local hrp = char.HumanoidRootPart
                local vec, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                    line.To = Vector2.new(vec.X, vec.Y)
                    line.Color, line.Visible = teamCol, true
                else
                    line.Visible = false
                end
            elseif tracers[p] then
                pcall(function() tracers[p]:Remove() end)
                tracers[p] = nil
            end

            if espBox and char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local bg = boxGUIs[p]
                if not bg then
                    bg = Instance.new("BillboardGui", hrp)
                    bg.Name, bg.AlwaysOnTop, bg.Size, bg.StudsOffset = "Box2DGUI", true, UDim2.new(3.5, 0, 5, 0), Vector3.new(0, 0, 0)
                    
                    local box = Instance.new("Frame", bg)
                    box.Size, box.Position, box.BackgroundTransparency = UDim2.new(0.85, 0, 1, 0), UDim2.new(0.15, 0, 0, 0), 1
                    local stroke = Instance.new("UIStroke", box)
                    stroke.Name, stroke.Thickness = "BoxStroke", 1.5

                    local hBg = Instance.new("Frame", bg)
                    hBg.Size, hBg.Position, hBg.BackgroundColor3 = UDim2.new(0.1, 0, 1, 0), UDim2.new(0, 0, 0, 0), Color3.fromRGB(0, 0, 0)
                    
                    local hFill = Instance.new("Frame", hBg)
                    hFill.Name, hFill.Size, hFill.BackgroundColor3 = "HealthFill", UDim2.new(1, 0, 1, 0), Color3.fromRGB(0, 255, 0)
                    boxGUIs[p] = bg
                else
                    local stroke = bg:FindFirstChild("BoxStroke", true)
                    local hFill = bg:FindFirstChild("HealthFill", true)
                    local hum = char:FindFirstChild("Humanoid")
                    if stroke then stroke.Color = teamCol end
                    if hFill and hum then
                        local maxH = hum.MaxHealth > 0 and hum.MaxHealth or 100
                        local curH = math.clamp(hum.Health, 0, maxH)
                        local hp = curH / maxH
                        hFill.Size = UDim2.new(1, 0, hp, 0)
                        hFill.Position = UDim2.new(0, 0, 1 - hp, 0)
                        
                        -- ระบบสีเลือดตามที่ต้องการ (100% เขียว, 75% เริ่มเหลือง, 50% เหลือง, 25% ส้ม, 10% แดง, 0% ดำ/ตาย)
                        if curH <= 0 then hFill.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                        elseif hp > 0.75 then hFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                        elseif hp > 0.50 then hFill.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
                        elseif hp > 0.25 then hFill.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                        elseif hp > 0.01 then hFill.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
                        else hFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0) end
                    end
                end
            elseif boxGUIs[p] then
                pcall(function() boxGUIs[p]:Destroy() end)
                boxGUIs[p] = nil
            end
        end
    end
end)

-- 3. ล็อคเป้าหมาย (Aimbot & FOV Circle)
local aimEn, aimPart, currentFOV = false, "Head", 50
createButton(C3, "เปิด/ปิด Aimbot", function(st) aimEn = st end)
createButton(C3, "สลับเป้าหมาย (หัว / ตัว)", function(st) aimPart = st and "HumanoidRootPart" or "Head" end)
createSlider(C3, "ขนาดวงกลม FOV", 1, 50, 1000, function(v) currentFOV = v end)

local fovC = Drawing and Drawing.new("Circle")
if fovC then 
    fovC.Visible = false 
    fovC.Thickness = 1.5 
    fovC.Color = Color3.fromRGB(200, 100, 255) 
    fovC.Filled = false 
end

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    if fovC then 
        fovC.Radius = currentFOV 
        fovC.Position = center 
        fovC.Visible = aimEn 
    end
    
    local target, minDist = nil, currentFOV
    for _, p in pairs(Players:GetPlayers()) do
        if not isSameTeam(p) and p.Character and p.Character:FindFirstChild(aimPart) then
            local part = p.Character[aimPart]
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < minDist then
                    minDist = dist
                    target = part
                end
            end
        end
    end

    if aimEn and target then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
    end
end)
